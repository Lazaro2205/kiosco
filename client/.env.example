# ============================================================
# FitoShop - client/.env.example
# Copiar a client/.env:  cp client/.env.example client/.env
# client/.env NO se sube a git (solo este .env.example).
# Vite solo expone al navegador las variables que empiezan con VITE_, así que
# acá NUNCA van secretos (la Secret Key de Clerk va en server/.env).
# Si cambiás algo, reiniciá "npm run dev:client".
# ============================================================

# URL base de la API (el server). Si no se define, el front usa
# http://localhost:4000. Sin "/" al final.
VITE_API_URL=http://localhost:4000

# Publishable Key de Clerk (empieza con pk_test_ o pk_live_):
# dashboard.clerk.com > tu app > API Keys.
# Todavía no se usa: el front aún no integra Clerk (Fase 1). Dejala vacía por
# ahora.
VITE_CLERK_PUBLISHABLE_KEY=