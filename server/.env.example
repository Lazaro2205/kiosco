# ============================================================
# FitoShop - server/.env.example
# Copiar a server/.env y completar:  cp server/.env.example server/.env
# server/.env NO se sube a git (solo este .env.example). No pongas valores
# reales acá.
# ============================================================

# --- Servidor ---
PORT=4000
# development | production. En production MONGODB_URI es obligatoria
# (no se usa la base en memoria).
NODE_ENV=development
# Origen(es) del front permitidos por CORS, separados por coma, sin "/" al
# final. Tiene que coincidir exacto con la URL del front (puerto incluido).
# Vacío = el server acepta cualquier origen (solo para desarrollo).
CORS_ORIGIN=http://localhost:5174

# --- Base de datos ---
# DEJALA VACÍA para trabajar con la base en memoria + datos demo (no necesita
# cuenta de Atlas; los datos se pierden al apagar el server).
# Para usar MongoDB Atlas, pegá la URI de tu cluster con el nombre de la base
# al final. Formato:
#   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/kiosko?retryWrites=true&w=majority
# (Atlas > Connect > Drivers. Si la password tiene caracteres especiales,
# codificarlos en formato URL.)
MONGODB_URI=

# --- Auth del operario (JWT propio) ---
# OBLIGATORIO: sin esto el login de operarios falla. Generá uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cada persona/entorno usa el suyo. Si cambia, se invalidan los tokens vigentes.
JWT_SECRET=

# --- Auth del propietario (Clerk) ---
# Secret Key de la app de Clerk (empieza con sk_test_ o sk_live_):
# dashboard.clerk.com > tu app > API Keys.
# Todavía no se usa: hoy el panel del dueño entra con devAuth (ver README).
# Se va a necesitar cuando se monte ownerAuth (Fase 1).
CLERK_SECRET_KEY=